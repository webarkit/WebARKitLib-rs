# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Google Antigravity local agent state (optional, but usually good to keep out of repos)
.agents/

# VSCode files
.vscode/

# Benchmarking and Example Artifacts
benchmarks/c_benchmark/src/
benchmarks/c_benchmark/build/
benchmarks/c_benchmark/archives/
benchmarks/data/hiro.raw
benchmarks/data/*.png
crates/core/examples/Data/found.jpg
crates/core/examples/Data/rust_*.png
**/.libraries.json

# WASM Build Artifacts
crates/wasm/pkg/
!crates/wasm/pkg/LICENSE
!crates/wasm/pkg/README.md
!crates/wasm/pkg/package.json
.DS_Store
